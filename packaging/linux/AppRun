#!/bin/sh
# [XCDE] T-LINUX-APPIMAGE: the AppImage mount is read-only, so everything the game and the launcher write (xcde.ini,
# cache/, saves, logs in build/) lives in a data folder outside it. That folder gets two links, refreshed at every
# start, so the launcher and the game keep the repository layout they use everywhere else:
#   <data>/targets           -> the game dump (exefs/ + romfs/)
#   <data>/build/linux/monado -> the game executable inside this mount
#   ./Monado-x86_64.AppImage [dump directory]       launcher
#   ./Monado-x86_64.AppImage --play [dump directory] the game directly
# The dump: the argument, else MONADO_GAME_ROOT, else targets/ next to the AppImage, else the one linked last time.
# The data folder (GitHub #88): MONADO_DATA_ROOT, else a monado-data folder next to the AppImage when there is one
# (portable: everything stays beside it), else $XDG_DATA_HOME/monado (~/.local/share/monado, as runtime/platform/linux.c).
# Before, it was $XDG_DATA_HOME/lasrecomp, the folder LASRecomp's Link's Awakening recomp uses too: one that holds
# Monado's xcde.ini keeps being used while there is no monado folder, so an update never loses saves or settings.
set -eu
appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export LD_LIBRARY_PATH="$appdir/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# FSR 4 Lite's model files: packaged (a local build with --fsr4-assets), else the data folder's fsr4/, which the
# launcher's "Prepare FSR 4 Lite" fills on this PC (runtime/nvn/vulkan/fsr4.c looks there by itself)
if [ -f "$appdir/usr/share/monado/fsr4/lite/t1080_m0/initializer.bin" ]; then
  export MONADO_FSR4_ASSET_DIR="${MONADO_FSR4_ASSET_DIR:-$appdir/usr/share/monado/fsr4}"
fi
export XCDE_VARIANTS_SEED="${XCDE_VARIANTS_SEED:-$appdir/usr/share/monado/variants_seed.bin}"
# Release AppImages: FSR 4 Lite's preparation tool (the launcher's "Prepare FSR 4 Lite")
if [ -x "$appdir/usr/share/monado/fsr4prep/monado-fsr4prep" ]; then
  export XCDE_FSR4PREP_DIR="${XCDE_FSR4PREP_DIR:-$appdir/usr/share/monado/fsr4prep}"
fi
# Release AppImages: the first-start game code builder (the launcher runs it once; the result goes to the data folder)
if [ -f "$appdir/usr/share/monado/gamebuild/link.json" ]; then
  export XCDE_GAMEBUILD_DIR="${XCDE_GAMEBUILD_DIR:-$appdir/usr/share/monado/gamebuild}"
fi
direct=
if [ "${1:-}" = --play ]; then direct=1; shift; fi
case "${1:-}" in
  -h|--help) echo "usage: ${APPIMAGE:-AppRun} [--play] [dump directory]"; exit 0;;
esac
root=${1:-${MONADO_GAME_ROOT:-}}
if [ "$#" -gt 0 ]; then shift; fi
if [ -z "$root" ] && [ -n "${APPIMAGE:-}" ] && [ -d "$(dirname -- "$APPIMAGE")/targets" ]; then root="$(dirname -- "$APPIMAGE")/targets"; fi
case "$root" in ""|/*) ;; *) root="$PWD/$root";; esac
data=${MONADO_DATA_ROOT:-}
if [ -z "$data" ] && [ -n "${APPIMAGE:-}" ] && [ -d "$(dirname -- "$APPIMAGE")/monado-data" ]; then
  data="$(dirname -- "$APPIMAGE")/monado-data"
fi
if [ -z "$data" ]; then
  case "${XDG_DATA_HOME:-}" in /*) base="$XDG_DATA_HOME";; *) base="${HOME:?HOME must be set}/.local/share";; esac
  data="$base/monado"
  if [ ! -e "$data" ] && [ -f "$base/lasrecomp/xcde.ini" ]; then data="$base/lasrecomp"; fi
fi
mkdir -p -- "$data/build/linux"
data=$(CDPATH= cd -- "$data" && pwd)
export LARECOMP_DATA_ROOT="$data"
if [ -n "$root" ]; then
  [ -f "$root/exefs/main" ] && [ -d "$root/romfs" ] || { echo "$root must contain exefs/main and romfs/ (your dump)" >&2; exit 2; }
  ln -sfn -- "$(CDPATH= cd -- "$root" && pwd)" "$data/targets"
fi
ln -sfn -- "$appdir/usr/bin/monado" "$data/build/linux/monado"
cd -- "$data"
if [ -z "$direct" ]; then exec "$appdir/usr/bin/monado-launcher" "$@"; fi
[ -f targets/exefs/main ] || { echo "No game dump: pass its directory once (it is remembered)" >&2; exit 2; }
exec "$appdir/usr/bin/monado" targets "$@"
